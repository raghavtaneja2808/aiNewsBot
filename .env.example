# --- Required ---
VENICE_API_KEY=
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model id used for everything (summaries + agent loop).
VENICE_MODEL=zai-org-glm-4.6
# OpenAI-compatible base URL. Default points at Venice. Override to swap providers
# (Groq, Together, Fireworks, etc.) without touching code.
LLM_BASE_URL=https://api.venice.ai/api/v1

# OPTIONAL: Groq key, used only for tiny narration messages ("🔎 pulling latest
# headlines…") posted while a tool is running, so the user sees activity during
# slower Venice calls. Leave empty to disable narrations entirely.
GROQ_API_KEY=
GROQ_NARRATION_MODEL=llama-3.1-8b-instant

# Comma-separated WhatsApp group JIDs the bot is allowed to read/respond in.
# DMs and any group NOT on this list are silently ignored.
# To find a group's JID: add the bot to the group, send any message in it,
# then run `pm2 logs ai-news-bot` (or check the dev terminal). The bot logs
# the JID once with the message "ignored message from non-allowlisted group".
# Group JIDs look like: 1203630xxxxxxxxxxx@g.us
ALLOWED_GROUP_JIDS=

# Secret enable code. Sending `/set group-<this value>` in any WhatsApp group
# adds that group to the persistent allowlist (stored in data/db.json).
# `/unset group-<this value>` removes it. Pick something unguessable.
# Leave empty to disable runtime enabling (env-only allowlist).
ENABLE_SECRET=

# --- Optional ---
# Comma-separated WhatsApp JIDs (e.g. 9198xxxxxxxx@s.whatsapp.net) that are
# allowed to do destructive things even if anyone-can-run is the default.
# Leave empty to keep "everyone allowed" behavior.
OWNER_JIDS=

# Default IANA timezone applied to a group on first auto-registration.
DEFAULT_TIMEZONE=UTC

# Default digest times (24h, comma-separated HH:MM) applied on first auto-registration.
DEFAULT_DIGEST_TIMES=08:00,20:00

# How many SerpAPI organic results to fetch per digest.
DIGEST_RESULTS=5

# Logger level: trace|debug|info|warn|error
LOG_LEVEL=info
