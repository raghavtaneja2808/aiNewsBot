{
  "name": "ai-news-bot",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp bot that sends twice-daily AI news digests and acts as a conversational agent (Baileys + Groq + OpenAI Agents SDK).",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "@openai/agents": "^0.0.14",
    "@whiskeysockets/baileys": "^6.7.18",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "chrono-node": "^2.7.7",
    "dotenv": "^16.4.7",
    "jsdom": "^25.0.1",
    "lowdb": "^7.0.1",
    "node-cron": "^3.0.3",
    "openai": "^4.77.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "qrcode-terminal": "^0.12.0",
    "serpapi": "^2.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.10"
  }
}
